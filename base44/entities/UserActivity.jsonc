{
  "name": "UserActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "registered",
        "logged_in",
        "created_session",
        "joined_session"
      ]
    },
    "project_public_id": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}