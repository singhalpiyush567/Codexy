{
  "name": "ProjectFile",
  "type": "object",
  "properties": {
    "project_public_id": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "project_public_id",
    "filename"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}